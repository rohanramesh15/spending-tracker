{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"],
      // shared/ sits above frontend/node_modules, so TypeScript can't resolve its bare
      // imports by walking up from those files (same reason vite.config.ts aliases them).
      // Mirror the runtime aliases here so type-checking and bundling agree.
      "date-fns": ["./node_modules/date-fns"],
      "@tanstack/*": ["./node_modules/@tanstack/*"],
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["src", "../shared"]
}
