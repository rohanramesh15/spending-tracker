# Copy to .env.local and fill in. Only EXPO_PUBLIC_* reaches the client bundle.
# These mirror the web app's VITE_* variables; none of them are secrets.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The backend Lambda Function URL. Leave empty only if you're pointing at a local proxy.
EXPO_PUBLIC_API_BASE_URL=https://<function-url>.lambda-url.<region>.on.aws

# Local-dev only: skip auth entirely (pairs with the backend's AUTH_DEV_BYPASS).
# NEVER set this in a build you install on a real device.
# EXPO_PUBLIC_AUTH_DEV_BYPASS=true
